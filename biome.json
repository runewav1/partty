{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/dist",
			"!!**/node_modules",
			"!!**/src/vendor",
			"!!**/*.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": "warn",
			"complexity": {
				"preset": "recommended",
				"noExcessiveLinesPerFunction": "off",
				"noImportantStyles": "off"
			},
			"correctness": "error",
			"performance": "warn",
			"security": {
				"preset": "recommended",
				"noSecrets": "warn"
			},
			"style": "off",
			"suspicious": {
				"preset": "recommended",
				"noConsole": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"linter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": [
				"vite.config.ts",
				"scripts/tauri.js",
				"scripts/*.mjs",
				"src/tests/*.test.mjs"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"useQwikValidLexicalScope": "off"
					}
				}
			}
		},
		{
			"includes": ["src/pty/perf.stub.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noEmptyBlockStatements": "off"
					}
				}
			}
		},
		{
			"includes": ["src/app/devMetricsOverlay.ts"],
			"linter": {
				"rules": {
					"security": {
						"noSecrets": "off"
					}
				}
			}
		},
		{
			"includes": ["src/terminal/keybinds.ts", "src/terminal/paneHost.ts"],
			"linter": {
				"rules": {
					"security": {
						"noSecrets": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.css", "index.html"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["src/main.ts"],
			"linter": {
				"rules": {
					"performance": {
						"noAwaitInLoops": "off",
						"useTopLevelRegex": "off"
					},
					"security": {
						"noSecrets": "off"
					},
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
