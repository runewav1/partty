{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Partty",
	"version": "0.6.0",
	"identifier": "com.partty.desktop",
	"build": {
		"beforeDevCommand": "pnpm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Partty",
				"width": 920,
				"height": 520,
				"resizable": true,
				"decorations": false,
				"transparent": true,
				"backgroundColor": "#2e2e32",
				"shadow": true,
				"skipTaskbar": false,
				"visible": false,
				"dragDropEnabled": false,
				"devtools": false,
				"additionalBrowserArgs": "--enable-gpu-rasterization --enable-zero-copy --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrouning-occluded-windows --disable-background-networking --disable-component-update --disable-domain-reliability --disable-speech-api --disable-hang-monitor --render-process-limit=1 --js-flags=--max_semi_space_size=64 --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,AutofillServerCommunication,OptimizationHints,MediaRouter,PrintPreview,WebOTP,PaymentRequest"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "nsis",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installerIcon": "icons/icon.ico",
				"uninstallerIcon": "icons/icon.ico"
			}
		}
	}
}
