{
	"identifier": "com.partty.desktop.dev",
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Partty",
				"width": 920,
				"height": 520,
				"resizable": true,
				"decorations": false,
				"transparent": true,
				"backgroundColor": "#2e2e32",
				"shadow": true,
				"skipTaskbar": false,
				"visible": false,
				"dragDropEnabled": false,
				"devtools": true,
				"additionalBrowserArgs": "--enable-gpu-rasterization --enable-zero-copy --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrouning-occluded-windows --disable-background-networking --disable-component-update --disable-domain-reliability --disable-speech-api --render-process-limit=1 --js-flags=--max_semi_space_size=64 --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,AutofillServerCommunication,OptimizationHints,MediaRouter,PrintPreview,WebOTP,PaymentRequest"
			}
		]
	}
}
